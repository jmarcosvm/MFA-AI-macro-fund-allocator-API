# Copie este arquivo para .env e preencha. O .env NUNCA vai para o git.
# O app também sobe sem .env (todas as variáveis são opcionais).

GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=

# O nome do modelo será definido depois (SPEC.md §8); deixe vazio por enquanto.
LLM_PRIMARY=
LLM_SECONDARY=

# Tempo de vida do cache em segundos (padrão: 21600 = 6 horas).
CACHE_TTL_SECONDS=21600
