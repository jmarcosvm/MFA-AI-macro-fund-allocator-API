# Copie este arquivo para .env e preencha. O .env NUNCA vai para o git.
# O app também sobe sem .env (todas as variáveis são opcionais).

GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=

# Nomes de modelo: você escolhe e preenche (deixe vazio até escolher; sem modelo, o
# provedor é pulado com aviso e a cadeia segue). SEM prefixo (nada de "gemini/").
# LLM_PRIMARY: nome do modelo do Gemini, como aparece no Google AI Studio (letras,
#   números, ponto, hífen e sublinhado; começa por letra ou número).
# LLM_SECONDARY: id do modelo da NVIDIA, exatamente como aparece no catálogo
#   build.nvidia.com/models (rótulo "Free Endpoint").
LLM_PRIMARY=
LLM_SECONDARY=

# Cadeia de LLM: timeout por chamada, orçamento total (s) e limite de tokens da resposta.
# Padrões em app/config.py; só descomente para mudar.
# LLM_TIMEOUT_SEGUNDOS=25
# LLM_ORCAMENTO_SEGUNDOS=45
# LLM_MAX_TOKENS=4096
# Enviar response_format (JSON) à NVIDIA: só ligue depois que o teste "internet" provar
# que o modelo escolhido aceita.
# LLM_SECONDARY_JSON_MODE=false

# Tempo de vida do cache em segundos (padrão: 21600 = 6 horas).
CACHE_TTL_SECONDS=21600
# TTL curto (s) para resposta em que o LLM falhou (origem "fallback"). Valor inicial sem
# fonte: 900 = 15 minutos.
CACHE_TTL_FALLBACK_SECONDS=900

# Origens permitidas pelo CORS, separadas por vírgula (ex.: https://meu-front.onrender.com).
# Vazio ou só espaços = "*" (qualquer origem). Fechar para o domínio do front na R8/R9.
CORS_ORIGINS=*

# Coleta do BCB: janela (dias antes de hoje) de cada série e timeout por chamada (s).
# Padrões em app/config.py; só descomente para mudar.
# JANELA_IBCBR_DIAS=480
# JANELA_DOLAR_DIAS=200
# JANELA_SELIC_DIAS=90
# JANELA_IPCA_DIAS=400
# JANELA_META_SELIC_DIAS=90
# BCB_TIMEOUT_SEGUNDOS=10
