# Copie este arquivo para .env e preencha. O .env NUNCA vai para o git.
# O app também sobe sem .env (todas as variáveis são opcionais).

GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=

# O nome do modelo será definido depois (SPEC.md §8); deixe vazio por enquanto.
LLM_PRIMARY=
LLM_SECONDARY=

# Tempo de vida do cache em segundos (padrão: 21600 = 6 horas).
CACHE_TTL_SECONDS=21600

# Coleta do BCB: janela (dias antes de hoje) de cada série e timeout por chamada (s).
# Padrões em app/config.py; só descomente para mudar.
# JANELA_IBCBR_DIAS=365
# JANELA_DOLAR_DIAS=120
# JANELA_SELIC_DIAS=60
# JANELA_IPCA_DIAS=150
# JANELA_META_SELIC_DIAS=90
# BCB_TIMEOUT_SEGUNDOS=10
